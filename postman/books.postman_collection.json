{
  "info": {
    "name": "persistence-demo — Books API",
    "description": "Exercises every route in BookController (/api/books). Run the folders in order with the Collection Runner: \"Happy path\" creates a book and stores its id in the `bookId` collection variable, which later requests reuse.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "bookId", "value": "" },
    { "key": "missingId", "value": "999999999" }
  ],
  "item": [
    {
      "name": "Happy path",
      "item": [
        {
          "name": "Create book",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201 Created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Body has generated id and echoes fields', () => {",
                  "    pm.expect(body.id).to.be.a('number');",
                  "    pm.expect(body.title).to.eql('Domain-Driven Design');",
                  "    pm.expect(body.author).to.eql('Eric Evans');",
                  "    pm.expect(body.isbn).to.eql('9780321125217');",
                  "    pm.expect(body.price).to.eql(54.99);",
                  "});",
                  "pm.test('Location header points to the new book', () => {",
                  "    pm.response.to.have.header('Location');",
                  "    pm.expect(pm.response.headers.get('Location')).to.match(new RegExp('/api/books/' + body.id + '$'));",
                  "});",
                  "pm.collectionVariables.set('bookId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Domain-Driven Design\",\n  \"author\": \"Eric Evans\",\n  \"isbn\": \"9780321125217\",\n  \"price\": 54.99\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/books",
              "host": ["{{baseUrl}}"],
              "path": ["api", "books"]
            }
          }
        },
        {
          "name": "List all books",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Returns an array', () => pm.expect(body).to.be.an('array'));",
                  "pm.test('Contains the created book', () => {",
                  "    const id = Number(pm.collectionVariables.get('bookId'));",
                  "    pm.expect(body.map(b => b.id)).to.include(id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/books",
              "host": ["{{baseUrl}}"],
              "path": ["api", "books"]
            }
          }
        },
        {
          "name": "List books by author (partial, case-insensitive)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Every result matches the author filter', () => {",
                  "    pm.expect(body.length).to.be.above(0);",
                  "    body.forEach(b => pm.expect(b.author.toLowerCase()).to.include('evans'));",
                  "});",
                  "pm.test('Contains the created book', () => {",
                  "    const id = Number(pm.collectionVariables.get('bookId'));",
                  "    pm.expect(body.map(b => b.id)).to.include(id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/books?author=EVANS",
              "host": ["{{baseUrl}}"],
              "path": ["api", "books"],
              "query": [{ "key": "author", "value": "EVANS" }]
            }
          }
        },
        {
          "name": "List books by author (no match)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns an empty array', () => pm.expect(pm.response.json()).to.eql([]));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/books?author=no-such-author-xyz",
              "host": ["{{baseUrl}}"],
              "path": ["api", "books"],
              "query": [{ "key": "author", "value": "no-such-author-xyz" }]
            }
          }
        },
        {
          "name": "Get book by id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Returns the requested book', () => {",
                  "    pm.expect(body.id).to.eql(Number(pm.collectionVariables.get('bookId')));",
                  "    pm.expect(body.title).to.eql('Domain-Driven Design');",
                  "    pm.expect(body.createdAt).to.be.a('string');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/books/{{bookId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "books", "{{bookId}}"]
            }
          }
        },
        {
          "name": "Update book",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Returns the updated book', () => {",
                  "    pm.expect(body.id).to.eql(Number(pm.collectionVariables.get('bookId')));",
                  "    pm.expect(body.title).to.eql('Domain-Driven Design: Tackling Complexity');",
                  "    pm.expect(body.price).to.eql(49.5);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Domain-Driven Design: Tackling Complexity\",\n  \"author\": \"Eric Evans\",\n  \"isbn\": \"9780321125217\",\n  \"price\": 49.50\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/books/{{bookId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "books", "{{bookId}}"]
            }
          }
        },
        {
          "name": "Delete book",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 204 No Content', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/books/{{bookId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "books", "{{bookId}}"]
            }
          }
        },
        {
          "name": "Get deleted book returns 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 404', () => pm.response.to.have.status(404));",
                  "pm.test('Body is a ProblemDetail', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.status).to.eql(404);",
                  "    pm.expect(body.detail).to.be.a('string');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/books/{{bookId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "books", "{{bookId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Not found (404)",
      "item": [
        {
          "name": "Get missing book",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 404', () => pm.response.to.have.status(404));",
                  "pm.test('Body is a ProblemDetail', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.status).to.eql(404);",
                  "    pm.expect(body.detail).to.be.a('string');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/books/{{missingId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "books", "{{missingId}}"]
            }
          }
        },
        {
          "name": "Update missing book",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 404', () => pm.response.to.have.status(404));",
                  "pm.test('Body is a ProblemDetail', () => pm.expect(pm.response.json().status).to.eql(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Ghost Book\",\n  \"author\": \"Nobody\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/books/{{missingId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "books", "{{missingId}}"]
            }
          }
        },
        {
          "name": "Delete missing book",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 404', () => pm.response.to.have.status(404));",
                  "pm.test('Body is a ProblemDetail', () => pm.expect(pm.response.json().status).to.eql(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/books/{{missingId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "books", "{{missingId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Validation (400)",
      "item": [
        {
          "name": "Create with blank title and author",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"\",\n  \"author\": \"   \"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/books",
              "host": ["{{baseUrl}}"],
              "path": ["api", "books"]
            }
          }
        },
        {
          "name": "Create with negative price",
          "event": [
            {
              "listen": "test",
